{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UPR Terminal",
  "version": "0.1.3",
  "identifier": "org.ultimatepr.station",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "../ultimatepr-station-icon.ico",
      "../ultimatepr-station-icon.png"
    ],
    "shortDescription": "UPR Terminal packet radio desktop",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "installerHooks": "installer-hooks.nsh",
        "customLanguageFiles": {
          "Polish": "Polish.nsh"
        }
      }
    },
    "resources": {
      "../docs/": "docs/",
      "../LICENSE": "LICENSE",
      "../TRADEMARKS.md": "TRADEMARKS.md",
      "../licenses/": "licenses/assets/",
      "target/legal/": "licenses/crates/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
